// Analytics V2 — production D1 database `games` (created and schema verified 2026-10-14).
// No GAMES_ANALYTICS KV binding. This Worker is deployed MANUALLY, never by site CI.
// See docs/analytics-v2-d1-runbook.md before any production operations.
{
  "name": "games-analytics",
  "main": "games-analytics.js",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "triggers": { "crons": ["17 19 * * *", "0 1 * * MON"] },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{
    "name": "ANALYTICS_RATE_LIMITER",
    "namespace_id": "14202610",
    "simple": { "limit": 180, "period": 60 }
  }],
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "games",
      "database_id": "f7ba2f62-92bc-42e4-8974-6811e026a6d1",
      "migrations_dir": "migrations/analytics"
    }
  ]
}
