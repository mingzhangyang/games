{
  "name": "mini-games-collection",
  "version": "1.0.0",
  "description": "A collection of mini games including Math Rain, Tetris, and Tank Battle",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "gen": "node scripts/gen-from-registry.mjs",
    "serve:static": "node scripts/serve-static.mjs 8899",
    "verify": "node tests/verify-all.mjs",
    "verify:quick": "node tests/verify-all.mjs --quick",
    "verify:changed": "node tests/verify-all.mjs --changed",
    "verify:daily": "node tests/verify-daily.mjs",
    "verify:tower-defense-dist": "npm run build && node scripts/run-smoke-dist.mjs tests/smoke-tower-defense.mjs",
    "build:shadow-loom-silhouettes": "node scripts/shadow-loom-build-silhouettes.mjs",
    "check:shadow-loom-silhouettes": "node scripts/shadow-loom-build-silhouettes.mjs --check",
    "verify:shadow-loom": "node tests/verify-shadow-loom-silhouettes.mjs",
    "new:game": "node tools/generators/new-game.mjs",
    "verify:tank-battle-art": "node tests/verify-tank-battle-art.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^7.0.0",
    "eslint": "^10.11.0",
    "puppeteer-core": "^25.10.0",
    "rollup-plugin-copy": "^3.5.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.24.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "type": "module"
}
